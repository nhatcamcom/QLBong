# ==========================================================================
# Mẫu biến môi trường. Sao chép thành .env rồi điền giá trị thật:
#   cp .env.example .env
# LƯU Ý: KHÔNG dùng dấu nháy quanh giá trị, KHÔNG có khoảng trắng quanh dấu =
#        (file được đọc theo định dạng .properties). File .env đã được .gitignore.
# ==========================================================================

# --- Kết nối MySQL ---
DB_URL=jdbc:mysql://localhost:3306/football_booking?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=

# --- Máy chủ ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- JWT (đổi giá trị này ở môi trường thật, tối thiểu 32 ký tự) ---
JWT_SECRET=doi-thanh-mot-chuoi-bi-mat-that-dai-toi-thieu-32-ky-tu
JWT_EXPIRATION_MS=86400000

# --- CORS: origin của Frontend Next.js (nhiều origin cách nhau bằng dấu phẩy) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
